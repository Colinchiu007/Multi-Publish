{
  "version": "1.2",
  "description": "字幕分割共享规则表（双实现单源：smart-sentence-splitter Python 与 Multi-Publish story2video-engine TypeScript 均从本文件加载；同步副本见 Multi-Publish packages/story2video-engine/src/subtitle-rules.json）",
  "defaults": {
    "min_chars_per_block": 8,
    "max_chars_per_block": 15,
    "max_chars_cap": 64
  },
  "rounding": {
    "mode": "half_up",
    "decimal_places": 2
  },
  "pipeline": [
    "split_sentences",
    "split_quote_boundaries",
    "length_split",
    "merge_short",
    "clean",
    "enforce_max",
    "assign_timestamps"
  ],
  "sentence_boundary": [
    "。",
    "！",
    "？",
    "…",
    ".",
    "!",
    "?"
  ],
  "priority_punct": [
    "。",
    "！",
    "？",
    "；",
    ".",
    "!",
    "?",
    ";",
    "，",
    ",",
    "、"
  ],
  "leading_punct": [
    "，",
    "、",
    "。",
    "！",
    "？",
    "；",
    ",",
    "!",
    "?",
    ";",
    "."
  ],
  "trailing_punct": [
    "。",
    "！",
    "？",
    "；",
    "，",
    "、",
    ".",
    "!",
    "?",
    ";",
    "…"
  ],
  "quote_pairs": [
    [
      "“",
      "”"
    ],
    [
      "‘",
      "’"
    ],
    [
      "「",
      "」"
    ],
    [
      "『",
      "』"
    ],
    [
      "《",
      "》"
    ],
    [
      "（",
      "）"
    ],
    [
      "【",
      "】"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "enum": {
    "higher_punct": [
      "。",
      "！",
      "？",
      "；",
      "…",
      ",",
      "!",
      "?",
      ";",
      ".",
      "，"
    ],
    "predicate_starters": [
      "那",
      "这",
      "我",
      "就",
      "便",
      "都",
      "也",
      "很",
      "更",
      "将",
      "会",
      "要",
      "能",
      "可",
      "是",
      "有",
      "为"
    ],
    "connectors": [
      "和",
      "及",
      "与"
    ]
  },
  "word_split": {
    "description": "词边界感知切分（v1.2）：无标点硬切/平衡切分时优先在不劈词的位置切分；切点判定=块首为连词/介词(good_lead)或块尾为助词/副词/句内标点(good_tail)，块首为强黏着后缀(bad_followers)时排除",
    "good_lead": "和与及而但或把被从向对为于并且且",
    "good_tail": "的得了是就都也还要会能可将则若虽因着过地得正于，、；：在",
    "bad_followers": "国剧化片视电频影音界族系权员长家学社党军政府市县省州部局处科室院校厂矿场店楼路桥河山海江湖城村镇乡队组班级期版本书报刊机器车船乐画图表单证票券卡账户号码网站页面件文档档案库数据信息系统程序软件硬件网络设备端口接口模块组件服务客户端前端后端中间层这那各每某本"
  }
}
