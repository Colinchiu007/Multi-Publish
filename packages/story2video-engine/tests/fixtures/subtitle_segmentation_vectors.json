      "id": "simple_single_block",
      "input": "今天天气真好，我们去公园散步。",
      "config": {
        "min_chars_per_block": 8,
        "max_chars_per_block": 15,
        "time_calculation_method": "proportional"
      },
      "expected_blocks": [
        "今天天气真好，我们去公园散步"
      ],
      "note": ""
    },
    {
      "id": "punct_split_blocks",
      "input": "今天天气真好，阳光洒在公园的长椅上，我们沿着小路散步。",
