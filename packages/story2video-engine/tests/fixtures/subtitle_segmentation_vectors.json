{
  "spec": "docs/subtitle-segmentation-spec.md",
  "description": "共享字幕分割测试向量（smart-sentence-splitter 与 Multi-Publish story2video-engine 双实现共用）",
  "vectors": [
    {
      "id": "simple_single_block",
      "input": "今天天气真好，我们去公园散步。",
      "config": {
        "min_chars_per_block": 8,
        "max_chars_per_block": 15,
        "time_calculation_method": "proportional"
      },
      "expected_blocks": [
        "今天天气真好，我们去公园散步"
      ],
      "note": ""
    },
    {
      "id": "punct_split_blocks",
      "input": "今天天气真好，阳光洒在公园的长椅上，我们沿着小路散步。",
      "config": {
        "min_chars_per_block": 8,
        "max_chars_per_block": 15,
        "time_calculation_method": "proportional"
      },
      "expected_blocks": [
        "今天天气真好",
        "阳光洒在公园的长椅上",
        "我们沿着小路散步"
      ],
      "note": "",
      "short_block_exceptions": [
        {
          "index": 0,
          "len": 6,
          "reason": "句首短片段：逗号边界标点优先切分（Step 3/6）"
        }
      ]
    },
    {
      "id": "multi_sentence",
      "input": "第一部分。第二部分，包含顿号、逗号、以及更多内容；第三部分？第四部分！",
      "config": {
        "min_chars_per_block": 8,
        "max_chars_per_block": 15,
        "time_calculation_method": "proportional"
      },
      "expected_blocks": [
        "第一部分",
        "第二部分，包含顿号",
        "逗号、以及更多内容",
        "第三部分",
        "第四部分"
      ],
      "note": "",
      "short_block_exceptions": [
        {
          "index": 0,
          "len": 4,
          "reason": "独立短句（Step 1 句界优先，块不跨句）"
        },
        {
          "index": 3,
          "len": 4,
          "reason": "独立短句"
        },
        {
          "index": 4,
          "len": 4,
          "reason": "独立短句"
        }
      ]
    },
    {
      "id": "quotes_speech",
      "input": "他说：“最近常来这里，清晨的空气最清新。”我点点头，继续往前走。",
      "config": {
        "min_chars_per_block": 8,
        "max_chars_per_block": 15,
        "time_calculation_method": "proportional"
      },
      "expected_blocks": [
        "他说：最近常来这里",
        "清晨的空气最清新",
        "我点点头，继续往前走"
      ],
      "note": ""
    },
    {
      "id": "quote_paired_in_block",
      "input": "他说“你好”然后离开。",
