OPS_DB_PATH=/data/ops-center/config.db
OPS_CONFIG_OUTPUT_DIR=/data/configs
OPS_ENCRYPTION_KEY=<generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
OPS_SECRET_KEY=<same as PO_SECRET_KEY>
OPS_JWT_SECRET=<same as PO_SECRET_KEY>
OPS_JWT_ALGORITHM=HS256
OPS_CORS_ORIGINS=*
# 模型目录只读同步端点（桌面端拉取运营配置）API Key；未配置 → 端点 404（fail-closed）
OPS_CATALOG_API_KEY=<generate a strong random key, e.g. openssl rand -hex 32>
# 本地管理员登录（自包含，替代 orchestrator 认证）：未配置且无管理员时登录 fail-closed
OPS_ADMIN_USERNAME=
OPS_ADMIN_PASSWORD=
